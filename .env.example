# Copia este archivo como .env y ajusta los valores (.env está ignorado por git).
# Las variables del sistema (p. ej. GitHub Secrets en la CI) tienen prioridad sobre .env.
# Un valor vacío equivale a "no definido": se usa el valor por defecto del ambiente.

# Ambiente objetivo (prod o staging). También se puede elegir con: pytest --env staging
TEST_ENV=prod

# URL base de la API de ReqRes (suite principal)
REQRES_BASE_URL=https://reqres.in/api

# API key gratuita de https://app.reqres.in (cabecera x-api-key).
# Si se deja vacía, el cliente NO envía la cabecera y se usa la cuota anónima por IP.
REQRES_API_KEY=

# URL base de restful-booker (suite complementaria)
BOOKER_BASE_URL=https://restful-booker.herokuapp.com

# Timeout por defecto de cada petición HTTP, en segundos
REQUEST_TIMEOUT_S=10
